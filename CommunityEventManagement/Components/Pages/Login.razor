@page "/login"
@page "/register"
@using Microsoft.AspNetCore.Authorization
@using CommunityEventManagement.Models.ViewModels
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<div class="auth-container d-flex align-items-center justify-content-center" style="min-height: 85vh; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 10px;">
    <div class="card auth-card shadow-lg" style="width: 420px; border-radius: 16px; border: none; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px);">
        <div class="card-body p-4">
            
            <!-- Tab switches -->
            <div class="d-flex justify-content-center mb-4 border-bottom pb-2">
                <a href="/login" class="btn btn-link text-decoration-none fw-bold @(!showRegister ? "text-primary" : "text-muted")">Login</a>
                <a href="/register" class="btn btn-link text-decoration-none fw-bold @(showRegister ? "text-primary" : "text-muted")">Register</a>
            </div>

            <!-- Error Notifications -->
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger py-2" role="alert">
                    @GetErrorMessage()
                </div>
            }

            @if (!showRegister)
            {
                <!-- LOGIN FORM -->
                <h4 class="text-center mb-4">Sign In</h4>
                <form method="post" action="/auth/login">
                    <AntiforgeryToken />
                    
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input name="Email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input name="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-3" style="border-radius: 8px;">Sign In</button>
                </form>
            }
            else
            {
                <!-- REGISTRATION FORM -->
                <h4 class="text-center mb-4">Create Account</h4>
                <form method="post" action="/auth/register">
                    <AntiforgeryToken />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input name="FullName" type="text" class="form-control" placeholder="John Doe" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input name="Email" type="email" class="form-control" placeholder="john@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input name="Password" type="password" class="form-control" placeholder="At least 6 characters" minlength="6" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input name="PhoneNumber" type="tel" class="form-control" placeholder="e.g. +123456789" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input name="Address" type="text" class="form-control" placeholder="Street, City" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 mt-3" style="border-radius: 8px;">Register &amp; Sign In</button>
                </form>
            }

        </div>
    </div>
</div>

@code {
    private bool showRegister = false;
    private RegisterViewModel registerModel = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.AbsolutePath.Contains("/register"))
        {
            showRegister = true;
        }
    }

    private string GetErrorMessage()
    {
        return Error switch
        {
            "validation" => "Please fill all fields correctly.",
            "invalid_credentials" => "Invalid Email or Password.",
            "email_exists" => "This email is already registered.",
            "server_error" => "Internal server error occurred.",
            _ => "An unexpected error occurred."
        };
    }
}
