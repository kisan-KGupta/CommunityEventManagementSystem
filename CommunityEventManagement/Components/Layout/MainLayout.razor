@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="user-badge">
                        <span>Welcome, <strong>@authState.User.Identity?.Name</strong></span>
                        <span class="badge bg-info ms-2">@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                    <a href="/auth/logout" class="btn btn-sm btn-outline-danger">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-sm btn-outline-primary">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
