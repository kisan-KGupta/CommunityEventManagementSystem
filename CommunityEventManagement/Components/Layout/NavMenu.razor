@using Microsoft.AspNetCore.Components.Authorization
@using CommunityEventManagement.Helper

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Community Events</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <!-- Admin Navigation items -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                @foreach (var item in adminNav)
                {
                    <div class="nav-item px-3">
                        <NavLink href="@item.Url" class="nav-link">
                            <span class="bi bi-calendar-event" aria-hidden="true"></span> @item.Title
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <!-- Participant Navigation items -->
        <AuthorizeView Roles="Participant">
            <Authorized>
                @foreach (var item in participantNav)
                {
                    <div class="nav-item px-3">
                        <NavLink href="@item.Url" class="nav-link">
                            <span class="bi bi-journal-bookmark" aria-hidden="true"></span> @item.Title
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private List<NavigationItem> adminNav = new();
    private List<NavigationItem> participantNav = new();

    protected override void OnInitialized()
    {
        adminNav = NavigationProvider.GetMenu("Admin");
        participantNav = NavigationProvider.GetMenu("Participant");
    }
}
